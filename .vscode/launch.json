{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run iGEM Wiki",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NO_COLOR": "1",
        "FORCE_COLOR": "0"
      },
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open already-running wiki",
      "url": "http://localhost:5173/worldshaper-nanjing/",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
